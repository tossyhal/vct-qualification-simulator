{
  "name": "@vct-sim/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply vct-sim --local",
    "db:migrate:remote": "wrangler d1 migrations apply vct-sim --remote"
  },
  "dependencies": {
    "@vct-sim/shared": "*",
    "hono": "^4.9.2"
  },
  "devDependencies": {
    "wrangler": "^4.117.0"
  }
}

